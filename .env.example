# Local development. Copy to .env; `npm run dev` reads it.
# Without DATABASE_URL the app uses an embedded PGlite database in .data/pglite.

# One-click test sign-in on this machine. Ignored when NODE_ENV=production.
DEV_LOGIN=1
PORT=8080

# Production (Erawan) sets these itself:
#   DATABASE_URL        from the postgres add-on
#   AUTH_ISSUER_URL, AUTH_CLIENT_ID, AUTH_CLIENT_SECRET, AUTH_JWKS_URL, AUTH_WELLKNOWN_URL
#                       from the auth add-on (Google, LINE and email sign-in)
# Optional: PUBLIC_URL=https://your-domain   (used to build the sign-in callback URL)
